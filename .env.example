# Local infrastructure for `docker compose up -d` (Postgres + Redis).
# Copy this file to `.env` and change the password. The real `.env` is gitignored.
POSTGRES_DB=giggo
POSTGRES_USER=giggo
POSTGRES_PASSWORD=change_me_locally

# NOTE: the backend and ML service read their own configuration from environment
# variables at deploy time — see docs/DEPLOYMENT.md for the full reference.
