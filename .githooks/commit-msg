#!/usr/bin/env sh
# Enforce Conventional Commits format on the commit message.

msg_file="$1"                       # git passes the path to the message file
subject=$(head -n 1 "$msg_file")    # we only check the first line

# Allow merge commits to pass through untouched
if printf '%s' "$subject" | grep -qE '^Merge '; then
  exit 0
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "------------------------------------------------------------"
  echo "  Commit rejected — message must follow Conventional Commits"
  echo ""
  echo "  Format:  type(optional-scope): short description"
  echo "  Example: feat(auth): add Google login"
  echo ""
  echo "  Types: feat, fix, docs, style, refactor, perf,"
  echo "         test, build, ci, chore, revert"
  echo "------------------------------------------------------------"
  exit 1
fi